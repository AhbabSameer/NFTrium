# Needed for minting: uploads go straight from the browser to Pinata (https://pinata.cloud).
# VITE_ variables are bundled into the browser code, so anyone can read this key.
VITE_PINATA_JWT=

# Optional
# VITE_SEPOLIA_RPC_URL=https://...
# VITE_IPFS_GATEWAY=https://<your-gateway>.mypinata.cloud/ipfs
